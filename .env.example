# Which AI writes your training data: anthropic, openai, gemini, openai_compatible, or mock (free, for testing)
PROVIDER=anthropic

# Leave empty to use the default model for the provider
MODEL=

# Your API key for that provider
API_KEY=

# Optional: where model calls go. Leave empty for the provider's normal address.
# Set it for an OpenAI-compatible server (Ollama: http://localhost:11434/v1) or a gateway
# such as veilox (openai: http://localhost:8080/v1, anthropic: http://localhost:8080).
BASE_URL=

# Protects LLMvero: callers must send "Authorization: Bearer <ACCESS_KEY>".
# Leave empty only on your own machine. On any shared or public server, set a long random value,
# e.g. the output of: openssl rand -hex 32
ACCESS_KEY=
